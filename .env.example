# Credentials for the providers in this skill.
# Copy to .env (git-ignored), uncomment only the providers you use, and load it:
#   set -a; source .env; set +a
# Terraform does not read .env on its own. Lines are commented out because an
# exported empty variable (for example AWS_ACCESS_KEY_ID=) can override a
# working CLI profile.

### AWS ###
# Either a CLI profile:
# AWS_PROFILE=
# or static keys (add AWS_SESSION_TOKEN for temporary credentials):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

### Alibaba Cloud ###
# Either a CLI profile from ~/.aliyun/config.json:
# ALIBABA_CLOUD_PROFILE=
# or RAM user keys (add ALIBABA_CLOUD_SECURITY_TOKEN for STS):
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=

### Tencent Cloud ###
# CAM sub-user keys (add TENCENTCLOUD_SECURITY_TOKEN for temporary credentials):
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_SECURITY_TOKEN=

### Huawei Cloud ###
# IAM user keys (add HW_SECURITY_TOKEN for temporary credentials):
# HW_ACCESS_KEY=
# HW_SECRET_KEY=
# HW_SECURITY_TOKEN=

### Cloudflare ###
# API token scoped to Zone:DNS:Edit on the target zone:
# CLOUDFLARE_API_TOKEN=
