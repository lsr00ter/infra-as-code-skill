---
# Copy to hosts.yml (git-ignored) and fill in the Terraform outputs:
#   ansible_host <- public_ip
#   ansible_user <- ssh_user
# The group names match the compute template directories.
all:
  children:
    aws:
      hosts:
        aws-demo:
          ansible_host: 198.51.100.10
          ansible_user: ubuntu
    alicloud:
      hosts:
        alicloud-demo:
          ansible_host: 198.51.100.11
          ansible_user: root
    tencentcloud:
      hosts:
        tencentcloud-demo:
          ansible_host: 198.51.100.12
          ansible_user: ubuntu
    huaweicloud:
      hosts:
        huaweicloud-demo:
          ansible_host: 198.51.100.13
          ansible_user: root
  vars:
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
