# Copy to terraform.tfvars (git-ignored) and edit.
zone_name = "example.com"

records = {
  app = {
    name    = "app.example.com"
    type    = "A"
    content = "198.51.100.20" # public_ip output of a compute template
    proxied = true
  }
  www = {
    name    = "www.example.com"
    type    = "CNAME"
    content = "app.example.com"
    proxied = true
  }
}
